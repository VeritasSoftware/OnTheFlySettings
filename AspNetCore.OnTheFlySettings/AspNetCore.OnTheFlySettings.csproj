<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>

	  <IsPackable>true</IsPackable>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <Authors>Shantanu</Authors>
	  <Company>Veritas Software</Company>
	  <Description>LiveHealthChecks - Client package for Real-Time Api Health Check Monitoring. Supports .NET 6/7/8/9/10.</Description>
	  <PackageProjectUrl>https://github.com/VeritasSoftware/LiveHealthChecks</PackageProjectUrl>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryUrl>https://github.com/VeritasSoftware/LiveHealthChecks</RepositoryUrl>
	  <PackageReleaseNotes>added feature to replace basic settings at runtime, without restarting the application.</PackageReleaseNotes>
	  <PackageTags>asp net core web api health check live real time signalr web sockets push notification client</PackageTags>
	  <Version>1.0.3</Version>
	  <AssemblyVersion>1.0.0.3</AssemblyVersion>
	  <FileVersion>1.0.0.3</FileVersion>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

	<ItemGroup>
		<!-- Include README -->
		<None Include="README.md" Pack="true" PackagePath="" />

		<!-- Include images folder -->
		<None Include="Images\**" Pack="true" PackagePath="images\" />
	</ItemGroup>
</Project>
