<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>

		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>Shantanu</Authors>
		<Company>Veritas Software</Company>
		<Description>Update your API/App config settings on-the-fly, at runtime, without needing a restart! Zero downtime! Supports .NET 8/9/10/11.</Description>
		<PackageProjectUrl>https://github.com/VeritasSoftware/OnTheFlySettings</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/VeritasSoftware/OnTheFlySettings</RepositoryUrl>
		<PackageReleaseNotes>
			Changelog
			- Support for .NET 11. Now supports .NET 8/9/10/11.
			- Support dropped for .NET 6/7. Please use version 3.x.x for .NET 6/7 support.
		</PackageReleaseNotes>
		<PackageTags>asp net core aws secrets manager azure key vault on the fly settings dynamic without restarting API application runtime no downtime</PackageTags>
		<Version>4.0.0</Version>
		<AssemblyVersion>4.0.0.0</AssemblyVersion>
		<FileVersion>4.0.0.0</FileVersion>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<!-- Include README -->
		<None Include=".\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<!-- Include images folder -->
	</ItemGroup>
</Project>